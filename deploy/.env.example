# Optional: copy to .env only to change something. Secrets are not set here: the setup service creates them.

# Time zone of the event timestamps and Frigate's UI, e.g. Europe/Rome
TZ=UTC

# Ports on this machine
PERCEZIONE_PORT=8090
FRIGATE_UI_PORT=8091

# Names of your own domain that open the UI, comma-separated (e.g. cams.example.org). Addresses, localhost and
# local names (server, *.local, *.lan, *.home.arpa) always work; any other name is refused (DNS rebinding).
#PERCEZIONE_HOSTS=

# A broker of your own (e.g. Home Assistant's Mosquitto) instead of the included one. Create two users there and,
# after the first start, put their logins in data/secrets/system.json (mqtt.frigate and mqtt.percezione), then
# docker compose up -d again.
#MQTT_HOST=192.0.2.10
#MQTT_PORT=1883

# go2rtc's ports for other apps (RTSP, and WebRTC when sharing is on: keep it 8555 for WebRTC to work)
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555

# "pose" profile: the ONNX models to download on first start (pose: posture; clip: left objects)
#ONNX_MODELS=pose clip

# Frigate's shared memory: about 128 MB per 1080p camera
FRIGATE_SHM_SIZE=512mb

# NVIDIA only (hardware/nvidia.yml): YOLOv9 size (t, s, m, c, e) and input (320 or 640)
#YOLO_MODEL_SIZE=t
#YOLO_IMG_SIZE=320

# Coral only (hardware/coral.yml): usb or pci
#CORAL_DEVICE=usb

# Intel only (hardware/intel.yml): the Intel GPU's render node, when it is not renderD128 (e.g. with an NVIDIA card
# too: see ls -l /dev/dri/by-path, Intel's is PCI 00:02.0)
#INTEL_RENDER_DEVICE=/dev/dri/renderD128

# A different image, e.g. a pinned version
#PERCEZIONE_IMAGE=ghcr.io/arkimedehq/percezione:0.1.1
